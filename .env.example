# ============================================================
# AI STOCK RESEARCH PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_NAME="AI Stock Research Platform"
APP_ENV=development         # development | production
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql+asyncpg://stockuser:stockpass@localhost:5432/stockresearch
# For SQLite dev mode (simpler, no Docker needed):
# DATABASE_URL=sqlite+aiosqlite:///./stockresearch.db

# ---- Redis Cache ----
REDIS_URL=redis://localhost:6379/0

# ---- Authentication ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- Data Provider Mode ----
# mock  = use built-in mock data provider (no API keys needed, clearly labelled DEMO)
# live  = use real API providers below
DATA_PROVIDER_MODE=mock

# ---- Market Data Provider ----
MARKET_DATA_PROVIDER=alpha_vantage   # alpha_vantage | yahoo_finance | fmp | mock
MARKET_DATA_API_KEY=your_alpha_vantage_api_key_here

# ---- Fundamental Data Provider ----
FUNDAMENTAL_DATA_PROVIDER=fmp        # fmp | simfin | mock
FUNDAMENTAL_DATA_API_KEY=your_fmp_api_key_here

# ---- News Provider ----
NEWS_PROVIDER=newsapi                # newsapi | gnews | mock
NEWS_API_KEY=your_newsapi_key_here

# ---- Economic Data Provider ----
ECONOMIC_DATA_PROVIDER=fred          # fred | mock
ECONOMIC_DATA_API_KEY=your_fred_api_key_here

# ---- Earnings Provider ----
EARNINGS_PROVIDER=fmp                # fmp | mock
# Uses FUNDAMENTAL_DATA_API_KEY

# ---- Analyst Data Provider ----
ANALYST_DATA_PROVIDER=fmp            # fmp | mock
# Uses FUNDAMENTAL_DATA_API_KEY

# ---- AI Research Engine ----
AI_PROVIDER=openai                   # openai | gemini | anthropic | mock
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o                      # gpt-4o | gemini-1.5-pro | claude-3-5-sonnet

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=10

# ---- Cache TTL (seconds) ----
PRICE_CACHE_TTL=30
FUNDAMENTALS_CACHE_TTL=3600
SCORES_CACHE_TTL=1800
NEWS_CACHE_TTL=300
SCREENER_CACHE_TTL=600

# ---- Frontend (set in frontend/.env) ----
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="StockIQ"
VITE_DEMO_MODE=true
